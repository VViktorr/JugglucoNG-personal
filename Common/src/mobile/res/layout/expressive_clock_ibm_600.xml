<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:gravity="start|center_vertical">
    <TextClock
        android:id="@+id/expressive_widget_clock"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textFontWeight="600"
        android:textSize="27sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="@font/ibm_plex_sans_var"
        android:fontVariationSettings="'wght' 600"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/expressive_widget_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:singleLine="true"
        android:textFontWeight="600"
        android:textSize="11sp"
        android:textColor="#CCFFFFFF"
        android:fontFamily="@font/ibm_plex_sans_var"
        android:fontVariationSettings="'wght' 600"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
</LinearLayout>
