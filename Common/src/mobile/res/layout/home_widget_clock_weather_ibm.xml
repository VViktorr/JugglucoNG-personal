<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_clock_weather" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
    <TextClock
        android:id="@+id/home_widget_clock"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="@font/ibm_plex_sans_var"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_date"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:fontFamily="@font/ibm_plex_sans_var"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    </LinearLayout>
</FrameLayout>
