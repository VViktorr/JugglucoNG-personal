<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_clock_weather" />
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical">
<FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <TextClock
        android:id="@+id/home_widget_clock_300"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:fontFamily="sans-serif-light"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_clock_400"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:visibility="visible"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_clock_500"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_clock_600"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_clock_700"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="12dp"
        android:paddingTop="0dp"
        android:paddingEnd="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />
    <TextView
        android:id="@+id/home_widget_glucose_300"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="38dp"
        android:fontFamily="sans-serif-light"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_glucose_400"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="38dp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:visibility="visible"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_glucose_500"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="38dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_glucose_600"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="38dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_glucose_700"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingTop="0dp"
        android:paddingEnd="38dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    </FrameLayout>

<FrameLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1">
    <TextClock
        android:id="@+id/home_widget_date_300"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif-light"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_date_400"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:visibility="visible"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_date_500"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_date_600"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    <TextClock
        android:id="@+id/home_widget_date_700"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|center_vertical"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEEE, d MMMM"
        android:format24Hour="EEEE, d MMMM"
        android:importantForAccessibility="yes" />
    <TextView
        android:id="@+id/home_widget_detail_300"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif-light"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="false"
        android:maxLines="3"
        android:breakStrategy="simple"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_detail_400"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="normal"
        android:visibility="visible"
        android:singleLine="false"
        android:maxLines="3"
        android:breakStrategy="simple"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_detail_500"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif-medium"
        android:textStyle="normal"
        android:visibility="gone"
        android:singleLine="false"
        android:maxLines="3"
        android:breakStrategy="simple"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_detail_600"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="false"
        android:maxLines="3"
        android:breakStrategy="simple"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    <TextView
        android:id="@+id/home_widget_detail_700"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="end|center_vertical"
        android:paddingStart="0dp"
        android:paddingEnd="12dp"
        android:paddingBottom="0dp"
        android:fontFamily="sans-serif"
        android:textStyle="bold"
        android:visibility="gone"
        android:singleLine="false"
        android:maxLines="3"
        android:breakStrategy="simple"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:importantForAccessibility="no" />
    </FrameLayout>
    </LinearLayout>
    <!-- The stale message owns the full height after the glucose dash is hidden. -->
    <FrameLayout
        android:id="@+id/home_widget_stale_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone">
        <TextView
            android:id="@+id/home_widget_stale_300"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:fontFamily="sans-serif-light"
            android:textStyle="normal"
            android:visibility="gone"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:importantForAccessibility="yes" />
        <TextView
            android:id="@+id/home_widget_stale_400"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:fontFamily="sans-serif"
            android:textStyle="normal"
            android:visibility="visible"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:importantForAccessibility="yes" />
        <TextView
            android:id="@+id/home_widget_stale_500"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:fontFamily="sans-serif-medium"
            android:textStyle="normal"
            android:visibility="gone"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:importantForAccessibility="yes" />
        <TextView
            android:id="@+id/home_widget_stale_600"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:visibility="gone"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:importantForAccessibility="yes" />
        <TextView
            android:id="@+id/home_widget_stale_700"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="end|center_vertical"
            android:paddingStart="0dp"
            android:paddingEnd="12dp"
            android:paddingBottom="0dp"
            android:fontFamily="sans-serif"
            android:textStyle="bold"
            android:visibility="gone"
            android:singleLine="false"
            android:scrollHorizontally="false"
            android:breakStrategy="simple"
            android:textSize="16sp"
            android:textColor="#FFFFFFFF"
            android:importantForAccessibility="yes" />
    </FrameLayout>
</FrameLayout>
