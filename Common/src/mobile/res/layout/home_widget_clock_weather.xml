<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/home_widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent">
    <ImageView
        android:id="@+id/home_widget_image"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="fitXY"
        android:contentDescription="@string/widget_clock_weather" />
    <!-- System clocks keep time and date current even if the app process is stopped. -->
    <TextClock
        android:id="@+id/home_widget_clock"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|top"
        android:paddingStart="12dp"
        android:paddingTop="4dp"
        android:paddingEnd="0dp"
        android:singleLine="true"
        android:textSize="48sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="h:mm"
        android:format24Hour="HH:mm"
        android:importantForAccessibility="yes" />

    <TextClock
        android:id="@+id/home_widget_date"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:gravity="start|bottom"
        android:paddingStart="14dp"
        android:paddingEnd="0dp"
        android:paddingBottom="8dp"
        android:singleLine="true"
        android:textSize="16sp"
        android:textColor="#FFFFFFFF"
        android:format12Hour="EEE, d MMMM"
        android:format24Hour="EEE, d MMMM"
        android:importantForAccessibility="yes" />
</FrameLayout>